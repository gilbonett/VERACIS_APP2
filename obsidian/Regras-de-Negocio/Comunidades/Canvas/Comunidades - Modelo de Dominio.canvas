{
	"nodes":[
		{"id":"da0community00da0","type":"text","text":"# Community\n**Entidade**\n\nname, slug (único), description,\nlat/lng, biomeId, authorId\n\nSem status, sem ciclo de vida.\nFábrica `toCreate()` sem caso de uso.","x":-160,"y":-80,"width":320,"height":180,"color":"6"},
