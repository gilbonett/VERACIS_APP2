		{"id":"i1queryslug0000000","type":"text","text":"@unique(slug) + @@index([slug]) → 2 índices na mesma coluna, 4 tabelas","x":-40,"y":-300,"width":260,"height":130},
		{"id":"i2gargaloslug00000","type":"text","text":"⚠️ Índice redundante — custo de escrita sem ganho de leitura\n⚠️ users_email_cpf_phone_idx: mesmo problema + phone nunca é leftmost","x":-40,"y":0,"width":260,"height":140,"color":"1"},
		{"id":"i3fixslug000000000","type":"text","text":"✅ DROP INDEX dos 4 slug_idx duplicados\n✅ DROP INDEX users_email_cpf_phone_idx","x":-40,"y":200,"width":260,"height":110,"color":"4"},
		{"id":"j0flowcommunities0","type":"text","text":"**Fluxo: GET /communities**\n\nfindManyWithQueries(biomeId)","x":320,"y":-460,"width":260,"height":90,"color":"3"},
