{
	"nodes":[
		{"id":"f0flowalerts0000","type":"text","text":"**Fluxo: GET /alerts**\n\nFeed principal (alto tráfego)","x":-1120,"y":-460,"width":260,"height":90,"color":"3"},
		{"id":"f1queryalerts0000","type":"text","text":"AlertDetailsRepository.findMany\n\nWHERE status IN(...) [AND community_id=?]\ninclude: author, community, comments+author, reactions, events→event→category, attachments","x":-1120,"y":-300,"width":260,"height":170},
		{"id":"f2gargaloalerts00","type":"text","text":"⚠️ Seq Scan (alerts sem índice)\n⚠️ Sem paginação (busca tudo)\n⚠️ include traz password/cpf/email do autor sem uso","x":-1120,"y":0,"width":260,"height":140,"color":"1"},
		{"id":"f3fixalerts000000","type":"text","text":"✅ CREATE INDEX alerts(status), alerts(community_id,status)\n✅ Paginação por cursor (orderBy createdAt desc)\n✅ select mínimo no include do author","x":-1120,"y":200,"width":260,"height":150,"color":"4"},
		{"id":"g0flowmetrics0000","type":"text","text":"**Fluxo: GET /alerts/metrics**\n\nDashboard por comunidade","x":-760,"y":-460,"width":260,"height":90,"color":"3"},
		{"id":"g1querymetrics000","type":"text","text":"AlertMetricsRepository.findByCommunityId\n\n3 queries paralelas: groupBy(status) + category.findMany+_count + event.findMany+_count","x":-760,"y":-300,"width":260,"height":170},
		{"id":"g2gargalometrics0","type":"text","text":"⚠️ community_id sem índice em alerts\n⚠️ _count correlacionado = 1 subquery por categoria/evento (N+1 de agregação)","x":-760,"y":0,"width":260,"height":140,"color":"1"},
		{"id":"g3fixmetrics000000","type":"text","text":"✅ CREATE INDEX alerts(community_id,status)\n✅ Trocar findMany+_count por groupBy(categoryId)/groupBy(eventId)","x":-760,"y":200,"width":260,"height":150,"color":"4"},
		{"id":"h0flowmembers0000","type":"text","text":"**Fluxo: listagem de membros**\n\nMembershipRepository.findManyByCommunityId","x":-400,"y":-460,"width":260,"height":90,"color":"3"},
		{"id":"h1querymembers000","type":"text","text":"findMany WHERE community_id = ?\n\nPK composta é (user_id, community_id) — community_id não é a coluna mais à esquerda","x":-400,"y":-300,"width":260,"height":150},
		{"id":"h2gargalomembers0","type":"text","text":"⚠️ PK composta não serve para filtro só por community_id → Seq Scan","x":-400,"y":0,"width":260,"height":110,"color":"1"},
		{"id":"h3fixmembers00000","type":"text","text":"✅ CREATE INDEX memberships(community_id)","x":-400,"y":200,"width":260,"height":90,"color":"4"},
