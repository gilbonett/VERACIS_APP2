{
  "name": "@veracis/schema",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm exec tsup",
    "clean": "rm -rf dist",
    "dev": "pnpm exec tsup --watch",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/**/*"
  },
  "dependencies": {
    "tsup": "^8.5.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/node": "^22.10.7",
    "@veracis/tsconfig": "workspace:*",
    "typescript": "^5.7.3"
  }
}
