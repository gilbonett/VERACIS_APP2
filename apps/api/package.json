{
  "name": "@veracis/api",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --env-file .env --watch",
    "build": "nest build",
    "start": "node dist/src/main",
    "debug": "nest start --debug --watch",
    "db:seed:dev": "prisma db seed --env-file .env",
    "db:seed:prod": "node dist/prisma/seed.js",
    "db:generate": "prisma generate --schema=prisma/models",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:cov:ci": "vitest run --coverage --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.branches=75 --coverage.thresholds.statements=80",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --test-timeout=30000",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
