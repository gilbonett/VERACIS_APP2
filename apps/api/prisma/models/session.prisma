model Session {
  id             String                @id @default(uuid())
  userAgent      String?               @map("user_agent")
  ipAddress      String?               @map("ip_address")
  deviceName     String?               @map("device_name")
  assuranceLevel SessionAssuranceLevel @map("assurance_level")

  authenticatedAt DateTime  @map("authenticated_at")
  lastActivityAt  DateTime  @map("last_activity_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoke_at")
  revokeReason    String?   @map("revoke_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokens SessionToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model SessionToken {
  id                String    @id @default(uuid())
  version           Int
  tokenHash         String    @unique @map("token_hash")
  consumedAt        DateTime? @map("consumed_at")
  replacedByVersion Int?      @map("replaced_by_version")

  createdAt DateTime @default(now()) @map("created_at")

  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_tokens")
}

enum SessionAssuranceLevel {
  LOW
  MEDIUM
  HIGH
}
